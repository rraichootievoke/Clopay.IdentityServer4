{
  // ── PRODUCTION PLACEHOLDER ─ nothing here is real yet. Every <PLACEHOLDER> must be replaced (environment variables / Key Vault)
  // before this environment is deployed; the app will fail to start while any remain. No production values are in
  // the Clopay IDP settings that were available, so they must come from the DBA / platform team: SQL server, IDP database name (expected: identityserverdb),
  // SQL login, and the Admin / STS host names. Start with a READ-ONLY SQL login (see _designs/Create-ReadOnly-Login.sql)
  // and explicit approval.
  // ── Admin UI - Production ── loaded when ASPNETCORE_ENVIRONMENT=Production ────────────────────────
  // (no production values were available)
  // Passwords are NOT stored in git. Supply them at deploy time with environment variables or Key Vault, e.g.
  //   ConnectionStrings__ConfigurationDbConnection=...   AdminConfiguration__ClientSecret=...
  "ConnectionStrings": {
    // The REAL Clopay IDP database - the clients, API resources, scopes and grants you manage here.
    "ConfigurationDbConnection": "Data Source=<PROD_SQL_SERVER>;Initial Catalog=<PROD_IDP_DATABASE>;Persist Security Info=True;User ID=<PROD_DB_USER>;Password=<DB_PASSWORD>;Connect Timeout=200;pooling=true;TrustServerCertificate=True;Max Pool Size=500",
    "PersistedGrantDbConnection": "Data Source=<PROD_SQL_SERVER>;Initial Catalog=<PROD_IDP_DATABASE>;Persist Security Info=True;User ID=<PROD_DB_USER>;Password=<DB_PASSWORD>;Connect Timeout=200;pooling=true;TrustServerCertificate=True;Max Pool Size=500",
    // The admin tool's own SQL Server database (admin users, audit log, data-protection keys).
    "IdentityDbConnection": "Data Source=<PROD_SQL_SERVER>;Initial Catalog=IdentityServerAdminDB;Persist Security Info=True;User ID=<PROD_DB_USER>;Password=<DB_PASSWORD>;Connect Timeout=200;pooling=true;TrustServerCertificate=True;Max Pool Size=500",
    "AdminLogDbConnection": "Data Source=<PROD_SQL_SERVER>;Initial Catalog=IdentityServerAdminDB;Persist Security Info=True;User ID=<PROD_DB_USER>;Password=<DB_PASSWORD>;Connect Timeout=200;pooling=true;TrustServerCertificate=True;Max Pool Size=500",
    "AdminAuditLogDbConnection": "Data Source=<PROD_SQL_SERVER>;Initial Catalog=IdentityServerAdminDB;Persist Security Info=True;User ID=<PROD_DB_USER>;Password=<DB_PASSWORD>;Connect Timeout=200;pooling=true;TrustServerCertificate=True;Max Pool Size=500",
    "DataProtectionDbConnection": "Data Source=<PROD_SQL_SERVER>;Initial Catalog=IdentityServerAdminDB;Persist Security Info=True;User ID=<PROD_DB_USER>;Password=<DB_PASSWORD>;Connect Timeout=200;pooling=true;TrustServerCertificate=True;Max Pool Size=500"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "IdentityServer4": "Warning"
    }
  },

  // SAFETY: never turn these on while ConfigurationDbConnection points at the IDP database -
  // the migrations and sample seed data would be written into the real client tables.
  "SeedConfiguration": { "ApplySeed": false },
  "DatabaseMigrationsConfiguration": { "ApplyDatabaseMigrations": false },

  "AdminConfiguration": {
    "IdentityAdminRedirectUri": "https://<PROD_ADMIN_HOST>/signin-oidc",
    "IdentityServerBaseUrl": "https://<PROD_STS_HOST>",
    "RequireHttpsMetadata": true,
    "ClientSecret": "<ADMIN_CLIENT_SECRET>"
  }
}
