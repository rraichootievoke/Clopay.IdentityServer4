{
  // ── Admin UI - Staging ── loaded when ASPNETCORE_ENVIRONMENT=Staging ────────────────────────
  // (same SQL server and IDP database as the Clopay IDP in /cAppSettings)
  // Passwords are NOT stored in git. Supply them at deploy time with environment variables or Key Vault, e.g.
  //   ConnectionStrings__ConfigurationDbConnection=...   AdminConfiguration__ClientSecret=...
  "ConnectionStrings": {
    // The REAL Clopay IDP database - the clients, API resources, scopes and grants you manage here.
    "ConfigurationDbConnection": "Data Source=MAS-SQL-01T;Initial Catalog=IdentityServerDB_DBStaging_New;Persist Security Info=True;User ID=PortalAdmin;Password=<DB_PASSWORD>;Connect Timeout=200;pooling=true;TrustServerCertificate=True;Max Pool Size=500",
    "PersistedGrantDbConnection": "Data Source=MAS-SQL-01T;Initial Catalog=IdentityServerDB_DBStaging_New;Persist Security Info=True;User ID=PortalAdmin;Password=<DB_PASSWORD>;Connect Timeout=200;pooling=true;TrustServerCertificate=True;Max Pool Size=500",
    // The admin tool's own SQL Server database (admin users, audit log, data-protection keys).
    "IdentityDbConnection": "Data Source=MAS-SQL-01T;Initial Catalog=IdentityServerAdminDB;Persist Security Info=True;User ID=PortalAdmin;Password=<DB_PASSWORD>;Connect Timeout=200;pooling=true;TrustServerCertificate=True;Max Pool Size=500",
    "AdminLogDbConnection": "Data Source=MAS-SQL-01T;Initial Catalog=IdentityServerAdminDB;Persist Security Info=True;User ID=PortalAdmin;Password=<DB_PASSWORD>;Connect Timeout=200;pooling=true;TrustServerCertificate=True;Max Pool Size=500",
    "AdminAuditLogDbConnection": "Data Source=MAS-SQL-01T;Initial Catalog=IdentityServerAdminDB;Persist Security Info=True;User ID=PortalAdmin;Password=<DB_PASSWORD>;Connect Timeout=200;pooling=true;TrustServerCertificate=True;Max Pool Size=500",
    "DataProtectionDbConnection": "Data Source=MAS-SQL-01T;Initial Catalog=IdentityServerAdminDB;Persist Security Info=True;User ID=PortalAdmin;Password=<DB_PASSWORD>;Connect Timeout=200;pooling=true;TrustServerCertificate=True;Max Pool Size=500"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "IdentityServer4": "Information"
    }
  },

  // SAFETY: never turn these on while ConfigurationDbConnection points at the IDP database -
  // the migrations and sample seed data would be written into the real client tables.
  "SeedConfiguration": { "ApplySeed": false },
  "DatabaseMigrationsConfiguration": { "ApplyDatabaseMigrations": false },

  "AdminConfiguration": {
    "IdentityAdminRedirectUri": "https://staging-iamui.clopay.com/signin-oidc",
    "IdentityServerBaseUrl": "https://staging-iamui-sts.clopay.com",
    "RequireHttpsMetadata": true,
    "ClientSecret": "<ADMIN_CLIENT_SECRET>"
  }
}
