{
  // One-time bootstrap seed for Production (only used when SeedConfiguration:ApplySeed=true against IdentityServerAdminDB).
  // Overlays identityserverdata.json: the sign-in client for this environment's Admin site, plus localhost for developers.
  // Set the secret from the environment: IdentityServerData__Clients__0__ClientSecrets__0__Value (must equal AdminConfiguration__ClientSecret).
  "IdentityServerData": {
    "Clients": [
      {
        "ClientUri": "https://<PROD_ADMIN_HOST>",
        "ClientSecrets": [ { "Value": "<SEED_ADMIN_CLIENT_SECRET>" } ],
        "RedirectUris": [ "https://<PROD_ADMIN_HOST>/signin-oidc", "https://localhost:44303/signin-oidc" ],
        "FrontChannelLogoutUri": "https://<PROD_ADMIN_HOST>/signout-oidc",
        "PostLogoutRedirectUris": [ "https://<PROD_ADMIN_HOST>/signout-callback-oidc", "https://localhost:44303/signout-callback-oidc" ],
        "AllowedCorsOrigins": [ "https://<PROD_ADMIN_HOST>", "https://localhost:44303" ]
      }
    ]
  }
}
