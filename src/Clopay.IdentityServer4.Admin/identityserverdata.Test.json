{
  // One-time bootstrap seed for Test (only used when SeedConfiguration:ApplySeed=true against IdentityServerAdminDB).
  // Overlays identityserverdata.json: the sign-in client for this environment's Admin site, plus localhost for developers.
  // Set the secret from the environment: IdentityServerData__Clients__0__ClientSecrets__0__Value (must equal AdminConfiguration__ClientSecret).
  "IdentityServerData": {
    "Clients": [
      {
        "ClientUri": "https://test-iamui.clopay.com",
        "ClientSecrets": [ { "Value": "<SEED_ADMIN_CLIENT_SECRET>" } ],
        "RedirectUris": [ "https://test-iamui.clopay.com/signin-oidc", "https://localhost:44303/signin-oidc" ],
        "FrontChannelLogoutUri": "https://test-iamui.clopay.com/signout-oidc",
        "PostLogoutRedirectUris": [ "https://test-iamui.clopay.com/signout-callback-oidc", "https://localhost:44303/signout-callback-oidc" ],
        "AllowedCorsOrigins": [ "https://test-iamui.clopay.com", "https://localhost:44303" ]
      }
    ]
  }
}
