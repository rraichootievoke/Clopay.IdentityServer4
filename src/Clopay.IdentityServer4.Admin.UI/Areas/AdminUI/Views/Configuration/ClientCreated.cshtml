@using Clopay.IdentityServer4.Admin.BusinessLogic.Dtos.Configuration
@using Clopay.IdentityServer4.Admin.UI.Configuration.Constants
@model ClientQuickCreateResultDto

@{
    ViewBag.Title = "Client created";
    Layout = "_Layout";
}

<div class="cl-page cl-narrow">
    <div class="cl-success-banner">
        <span class="oi oi-circle-check" aria-hidden="true"></span>
        <div>
            <h1 class="cl-title">Client created</h1>
            <p class="cl-subtitle mb-0"><strong>@Model.ClientId</strong> is ready to use.</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.Secret))
    {
        @await Html.PartialAsync("Client/SecretReveal", Model.Secret)
    }
    else
    {
        <div class="alert alert-info mt-4">This type of client does not use a secret, so none was generated.</div>
    }

    <div class="cl-form-actions">
        <a asp-area="@CommonConsts.AdminUIArea" asp-action="Client" asp-route-id="@Model.Id" class="btn btn-primary">Review settings</a>
        <a asp-area="@CommonConsts.AdminUIArea" asp-action="ClientNew" class="btn btn-secondary">Create another</a>
        <a asp-area="@CommonConsts.AdminUIArea" asp-action="Clients" class="btn btn-link">Back to clients</a>
    </div>
</div>
