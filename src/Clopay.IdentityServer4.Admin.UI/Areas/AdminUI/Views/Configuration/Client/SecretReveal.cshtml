@model string

<div class="cl-secret-box" id="secret-box">
    <div class="cl-secret-title"><span class="oi oi-lock-locked" aria-hidden="true"></span> Client secret</div>
    <div class="input-group">
        <input id="new-secret" type="text" class="form-control cl-secret-value" readonly value="@Model" onclick="this.select();" />
        <div class="input-group-append">
            <button type="button" class="btn btn-primary" id="copy-secret"><span class="oi oi-clipboard" aria-hidden="true"></span> Copy</button>
        </div>
    </div>
    <p class="cl-secret-warning">Copy it now and store it somewhere safe (for example Key Vault). For security only a hash is stored, so <strong>this secret cannot be shown again</strong>. If it is lost, rotate the secret to get a new one.</p>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var btn = document.getElementById('copy-secret');
        var input = document.getElementById('new-secret');
        if (!btn) return;
        btn.addEventListener('click', function () {
            input.select();
            var done = function () { btn.innerHTML = '<span class="oi oi-check"></span> Copied'; };
            if (navigator.clipboard && window.isSecureContext) {
                navigator.clipboard.writeText(input.value).then(done);
            } else {
                document.execCommand('copy'); done();
            }
        });
    });
</script>
