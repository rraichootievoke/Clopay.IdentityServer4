{
  // ── PRODUCTION PLACEHOLDER ─ nothing here is real yet. Every <PLACEHOLDER> must be replaced (environment variables / Key Vault)
  // before this environment is deployed; the app will fail to start while any remain. No production values are in
  // the Clopay IDP settings that were available, so they must come from the DBA / platform team: SQL server, IDP database name (expected: identityserverdb),
  // SQL login, and the Admin / STS host names. Start with a READ-ONLY SQL login (see _designs/Create-ReadOnly-Login.sql)
  // and explicit approval.
  // ── Admin tool's own sign-in service (STS) - Production ── loaded when ASPNETCORE_ENVIRONMENT=Production ──
  // NOT the Clopay IDP: it only uses the small IdentityServerAdminDB. Replace <DB_PASSWORD> at deploy time.
  "ConnectionStrings": {
    "ConfigurationDbConnection": "Data Source=<PROD_SQL_SERVER>;Initial Catalog=IdentityServerAdminDB;Persist Security Info=True;User ID=<PROD_DB_USER>;Password=<DB_PASSWORD>;Connect Timeout=200;pooling=true;TrustServerCertificate=True;Max Pool Size=500",
    "PersistedGrantDbConnection": "Data Source=<PROD_SQL_SERVER>;Initial Catalog=IdentityServerAdminDB;Persist Security Info=True;User ID=<PROD_DB_USER>;Password=<DB_PASSWORD>;Connect Timeout=200;pooling=true;TrustServerCertificate=True;Max Pool Size=500",
    "IdentityDbConnection": "Data Source=<PROD_SQL_SERVER>;Initial Catalog=IdentityServerAdminDB;Persist Security Info=True;User ID=<PROD_DB_USER>;Password=<DB_PASSWORD>;Connect Timeout=200;pooling=true;TrustServerCertificate=True;Max Pool Size=500",
    "DataProtectionDbConnection": "Data Source=<PROD_SQL_SERVER>;Initial Catalog=IdentityServerAdminDB;Persist Security Info=True;User ID=<PROD_DB_USER>;Password=<DB_PASSWORD>;Connect Timeout=200;pooling=true;TrustServerCertificate=True;Max Pool Size=500"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "IdentityServer4": "Warning"
    }
  },

  "CertificateConfiguration": {
    // The temporary key is only for Development/Local. Deployed environments need a real signing certificate.
    "UseTemporarySigningKeyForDevelopment": false
  },
  // Admin accounts are created by an administrator, not self-registered.
  "RegisterConfiguration": { "Enabled": false },
  "AdminConfiguration": {
    "IdentityAdminBaseUrl": "https://<PROD_ADMIN_HOST>"
  }
}
