{
  // ── Admin tool's own sign-in service (STS) - Staging ── loaded when ASPNETCORE_ENVIRONMENT=Staging ──
  // NOT the Clopay IDP: it only uses the small IdentityServerAdminDB. The SQL login for this environment is stored here.
  "ConnectionStrings": {
    "ConfigurationDbConnection": "Data Source=MAS-SQL-01T;Initial Catalog=IdentityServerAdminDB;Persist Security Info=True;User ID=PortalAdmin;Password=PortalAdmin@123;Connect Timeout=200;pooling=true;TrustServerCertificate=True;Max Pool Size=100",
    "PersistedGrantDbConnection": "Data Source=MAS-SQL-01T;Initial Catalog=IdentityServerAdminDB;Persist Security Info=True;User ID=PortalAdmin;Password=PortalAdmin@123;Connect Timeout=200;pooling=true;TrustServerCertificate=True;Max Pool Size=100",
    "IdentityDbConnection": "Data Source=MAS-SQL-01T;Initial Catalog=IdentityServerAdminDB;Persist Security Info=True;User ID=PortalAdmin;Password=PortalAdmin@123;Connect Timeout=200;pooling=true;TrustServerCertificate=True;Max Pool Size=100",
    "DataProtectionDbConnection": "Data Source=MAS-SQL-01T;Initial Catalog=IdentityServerAdminDB;Persist Security Info=True;User ID=PortalAdmin;Password=PortalAdmin@123;Connect Timeout=200;pooling=true;TrustServerCertificate=True;Max Pool Size=100"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "IdentityServer4": "Information"
    }
  },

  "CertificateConfiguration": {
    // Non-production tiers may use IdentityServer's temporary signing key (written to tempkey.jwk next to the app, so the app pool
    // identity needs Modify rights on the site folder). Production must use a real certificate - see appsettings.Production.json.
    "UseTemporarySigningKeyForDevelopment": true
  },
  // Admin accounts are created by an administrator, not self-registered.
  "RegisterConfiguration": { "Enabled": false },
  "AdminConfiguration": {
    "IdentityAdminBaseUrl": "https://staging-iamui.clopay.com"
  }
}
