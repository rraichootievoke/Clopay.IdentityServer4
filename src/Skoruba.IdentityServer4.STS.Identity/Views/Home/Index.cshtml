@using IdentityServer4.Extensions
@using Skoruba.IdentityServer4.STS.Identity.Configuration.Interfaces
@inject IRootConfiguration RootConfiguration

<div class="cl-page cl-narrow">
    <h1 class="cl-title">@RootConfiguration.AdminConfiguration.PageTitle</h1>
    <p class="cl-subtitle">Sign-in service for the Clopay IAM Admin site.</p>

    <div class="cl-tiles">
        @if (!User.IsAuthenticated())
        {
            <a class="cl-tile cl-tile-accent" asp-controller="Account" asp-action="Login">
                <span class="cl-tile-icon oi oi-lock-locked" aria-hidden="true"></span>
                <span class="cl-tile-label">Sign in</span>
                <span class="cl-tile-hint">Use your admin account</span>
            </a>
        }
        else
        {
            <a class="cl-tile" asp-controller="Manage" asp-action="Index">
                <span class="cl-tile-icon oi oi-person" aria-hidden="true"></span>
                <span class="cl-tile-label">My profile</span>
                <span class="cl-tile-hint">Name, email and contact details</span>
            </a>
            <a class="cl-tile" asp-controller="Manage" asp-action="ChangePassword">
                <span class="cl-tile-icon oi oi-pencil" aria-hidden="true"></span>
                <span class="cl-tile-label">Change password</span>
                <span class="cl-tile-hint">Keep your admin account secure</span>
            </a>
            <a class="cl-tile" asp-controller="Manage" asp-action="TwoFactorAuthentication">
                <span class="cl-tile-icon oi oi-phone" aria-hidden="true"></span>
                <span class="cl-tile-label">Two-factor sign-in</span>
                <span class="cl-tile-hint">Add an authenticator app</span>
            </a>
            <a class="cl-tile" asp-controller="Grants" asp-action="Index">
                <span class="cl-tile-icon oi oi-key" aria-hidden="true"></span>
                <span class="cl-tile-label">Apps with access</span>
                <span class="cl-tile-hint">Review and revoke access</span>
            </a>
        }
    </div>
</div>
