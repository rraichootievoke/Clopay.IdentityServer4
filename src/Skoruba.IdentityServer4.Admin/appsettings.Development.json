{
  // ── Admin UI - Development ── loaded when ASPNETCORE_ENVIRONMENT=Development ────────────────────────
  // Values follow the Clopay IDP settings in /cAppSettings (same SQL server, same IDP database).
  // Passwords are NOT stored in git: replace <DB_PASSWORD> / <ADMIN_CLIENT_SECRET> at deploy time with
  // environment variables or Key Vault, e.g.  ConnectionStrings__ConfigurationDbConnection=...
  "ConnectionStrings": {
    // The REAL Clopay IDP database - the clients, API resources, scopes and grants you manage here.
    "ConfigurationDbConnection": "Data Source=10.103.3.4;Initial Catalog=IdentityServerDev;Persist Security Info=True;User ID=PortalAdmin;Password=<DB_PASSWORD>;Connect Timeout=200;pooling=true;Max Pool Size=100",
    "PersistedGrantDbConnection": "Data Source=10.103.3.4;Initial Catalog=IdentityServerDev;Persist Security Info=True;User ID=PortalAdmin;Password=<DB_PASSWORD>;Connect Timeout=200;pooling=true;Max Pool Size=100",
    // The admin tool's own small database (admin users, audit log, data-protection keys).
    "IdentityDbConnection": "Data Source=10.103.3.4;Initial Catalog=IdentityServerAdminDB;Persist Security Info=True;User ID=PortalAdmin;Password=<DB_PASSWORD>;Connect Timeout=200;pooling=true;Max Pool Size=100",
    "AdminLogDbConnection": "Data Source=10.103.3.4;Initial Catalog=IdentityServerAdminDB;Persist Security Info=True;User ID=PortalAdmin;Password=<DB_PASSWORD>;Connect Timeout=200;pooling=true;Max Pool Size=100",
    "AdminAuditLogDbConnection": "Data Source=10.103.3.4;Initial Catalog=IdentityServerAdminDB;Persist Security Info=True;User ID=PortalAdmin;Password=<DB_PASSWORD>;Connect Timeout=200;pooling=true;Max Pool Size=100",
    "DataProtectionDbConnection": "Data Source=10.103.3.4;Initial Catalog=IdentityServerAdminDB;Persist Security Info=True;User ID=PortalAdmin;Password=<DB_PASSWORD>;Connect Timeout=200;pooling=true;Max Pool Size=100"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "IdentityServer4": "Debug"
    }
  },

  // SAFETY: never turn these on while ConfigurationDbConnection points at the IDP database -
  // the migrations and sample seed data would be written into the real client tables.
  "SeedConfiguration": { "ApplySeed": false },
  "DatabaseMigrationsConfiguration": { "ApplyDatabaseMigrations": false },

  "AdminConfiguration": {
    "IdentityAdminRedirectUri": "https://dev-iamui.clopay.com/signin-oidc",
    "IdentityServerBaseUrl": "https://dev-iamui-sts.clopay.com",
    "RequireHttpsMetadata": true,
    "ClientSecret": "<ADMIN_CLIENT_SECRET>"
  }
}
