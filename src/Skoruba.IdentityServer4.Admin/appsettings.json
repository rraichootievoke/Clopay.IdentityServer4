        "AdminAuditLogDbConnection": "Data Source=10.105.3.4;Initial Catalog=IdentityServerAdminDB;Persist Security Info=True;User ID=PortalAdmin;Password=_EDBTestServer160923;Connect Timeout=200;pooling=true;Max Pool Size=500",
