{
  // ── Admin UI, Test ─ loaded when ASPNETCORE_ENVIRONMENT=Test ──────────────────
  // Overlay on appsettings.json. Replace <DB_PASSWORD> (and the TODO hostnames) at deploy
  // time, or better, inject via env vars / Key Vault, e.g.
  //   ConnectionStrings__ConfigurationDbConnection=...
  // Do NOT commit real credentials.
  //
  // ConfigurationDb/PersistedGrantDb = the REAL Clopay IDP database for this environment.
  // The four bookkeeping connections = the Admin tool's own IdentityServerAdminDB on the
  // same server (must exist / be migrated once, see below).
  "ConnectionStrings": {
    "ConfigurationDbConnection": "Data Source=10.105.3.4;Initial Catalog=IdentityServerDB_DBTest;Persist Security Info=True;User ID=PortalAdmin;Password=<DB_PASSWORD>;Connect Timeout=200;pooling=true;Max Pool Size=500",
    "PersistedGrantDbConnection": "Data Source=10.105.3.4;Initial Catalog=IdentityServerDB_DBTest;Persist Security Info=True;User ID=PortalAdmin;Password=<DB_PASSWORD>;Connect Timeout=200;pooling=true;Max Pool Size=500",
    "IdentityDbConnection": "Data Source=10.105.3.4;Initial Catalog=IdentityServerAdminDB;Persist Security Info=True;User ID=PortalAdmin;Password=<DB_PASSWORD>;Connect Timeout=200;pooling=true;Max Pool Size=500",
    "AdminLogDbConnection": "Data Source=10.105.3.4;Initial Catalog=IdentityServerAdminDB;Persist Security Info=True;User ID=PortalAdmin;Password=<DB_PASSWORD>;Connect Timeout=200;pooling=true;Max Pool Size=500",
    "AdminAuditLogDbConnection": "Data Source=10.105.3.4;Initial Catalog=IdentityServerAdminDB;Persist Security Info=True;User ID=PortalAdmin;Password=<DB_PASSWORD>;Connect Timeout=200;pooling=true;Max Pool Size=500",
    "DataProtectionDbConnection": "Data Source=10.105.3.4;Initial Catalog=IdentityServerAdminDB;Persist Security Info=True;User ID=PortalAdmin;Password=<DB_PASSWORD>;Connect Timeout=200;pooling=true;Max Pool Size=500"
  },
  // SAFETY: migrations/seed run against ALL contexts including the real IDP database
  // (Skoruba's EF migrations + default clients/scopes). Keep both false here. To create the
  // IdentityServerAdminDB schema once, run the app with the /migrateonly argument against a
  // scratch config that points ONLY the Identity/Log/AuditLog/DataProtection strings at it.
  "SeedConfiguration": { "ApplySeed": false },
  "DatabaseMigrationsConfiguration": { "ApplyDatabaseMigrations": false },
  "AdminConfiguration": {
    // TODO: real hostnames for the Admin UI and its STS login site in Test.
    "IdentityAdminRedirectUri": "https://TODO-Test-iamadmin.clopay.com/signin-oidc",
    "IdentityServerBaseUrl": "https://TODO-Test-iamadmin-sts.clopay.com",
    "RequireHttpsMetadata": true,
    "ClientSecret": "<ADMIN_CLIENT_SECRET>"
  }
}
