@using IdentityServer4.Extensions
@using Microsoft.AspNetCore.Hosting
@using Skoruba.IdentityServer4.Admin.UI.Configuration
@using Skoruba.IdentityServer4.Admin.UI.Configuration.Constants
@inject AdminConfiguration AdminConfiguration
@inject IWebHostEnvironment HostEnvironment
@{
    var controller = (ViewContext.RouteData.Values["controller"] ?? string.Empty).ToString();
    var action = (ViewContext.RouteData.Values["action"] ?? string.Empty).ToString();

    string Active(params string[] controllers) => controllers.Contains(controller) ? "active" : string.Empty;

    var environmentName = HostEnvironment.EnvironmentName;
    var isProduction = string.Equals(environmentName, "Production", StringComparison.OrdinalIgnoreCase);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="@UrlHelper.Content(AdminConfiguration.FaviconUri)" />
    <link rel="shortcut icon" type="image/x-icon" href="@UrlHelper.Content(AdminConfiguration.FaviconUri)" />
    <title>@ViewData["Title"] - @AdminConfiguration.PageTitle</title>

    <link href="~/dist/css/bundle.min.css" asp-append-version="true" rel="stylesheet" />
    <link href="~/css/clopay.css" asp-append-version="true" rel="stylesheet" />

    @await RenderSectionAsync("styles", required: false)
</head>
<body>

    <!-- Top bar: brand + environment + signed-in user -->
    <header class="cl-header">
        <div class="cl-header-inner">
            <a class="cl-brand" asp-area="@CommonConsts.AdminUIArea" asp-controller="Home" asp-action="Index">
                <span class="cl-logo">Clopay<small>CORPORATION</small></span>
                <span class="cl-product">@AdminConfiguration.PageTitle</span>
            </a>

            <span class="cl-env @(isProduction ? "cl-env-prod" : "cl-env-nonprod")" title="Environment">@environmentName</span>

            <div class="cl-header-right">
                @if (User.Identity.IsAuthenticated)
                {
                    <span class="cl-user"><span class="oi oi-person" aria-hidden="true"></span> @User.GetDisplayName()</span>
                    <a class="cl-logout" asp-area="@CommonConsts.AdminUIArea" asp-controller="Account" asp-action="Logout">Sign out</a>
                }
            </div>
        </div>
    </header>

    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg cl-nav">
        <div class="cl-nav-inner">
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#cl-nav-items" aria-controls="cl-nav-items" aria-expanded="false" aria-label="Menu">
                <span class="oi oi-menu"></span> Menu
            </button>

            <div class="collapse navbar-collapse" id="cl-nav-items">
                <ul class="navbar-nav">
                    <li class="nav-item @Active("Home")">
                        <a class="nav-link" asp-area="@CommonConsts.AdminUIArea" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item @(controller == "Configuration" && action.StartsWith("Client") ? "active" : "")">
                        <a class="nav-link" asp-area="@CommonConsts.AdminUIArea" asp-controller="Configuration" asp-action="Clients">Clients</a>
                    </li>
                    <li class="nav-item dropdown @(controller == "Configuration" && !action.StartsWith("Client") ? "active" : "")">
                        <a class="nav-link dropdown-toggle" href="#" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">APIs &amp; Scopes</a>
                        <div class="dropdown-menu">
                            <a class="dropdown-item" asp-area="@CommonConsts.AdminUIArea" asp-controller="Configuration" asp-action="ApiResources">API resources</a>
                            <a class="dropdown-item" asp-area="@CommonConsts.AdminUIArea" asp-controller="Configuration" asp-action="ApiScopes">API scopes</a>
                            <a class="dropdown-item" asp-area="@CommonConsts.AdminUIArea" asp-controller="Configuration" asp-action="IdentityResources">Identity resources</a>
                        </div>
                    </li>
                    <li class="nav-item @Active("Grant")">
                        <a class="nav-link" asp-area="@CommonConsts.AdminUIArea" asp-controller="Grant" asp-action="PersistedGrants">Active sessions</a>
                    </li>
                    <li class="nav-item dropdown @Active("Identity")">
                        <a class="nav-link dropdown-toggle" href="#" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">Admin access</a>
                        <div class="dropdown-menu">
                            <a class="dropdown-item" asp-area="@CommonConsts.AdminUIArea" asp-controller="Identity" asp-action="Users">Admin users</a>
                            <a class="dropdown-item" asp-area="@CommonConsts.AdminUIArea" asp-controller="Identity" asp-action="Roles">Roles</a>
                        </div>
                    </li>
                    <li class="nav-item dropdown @Active("Log")">
                        <a class="nav-link dropdown-toggle" href="#" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">Logs</a>
                        <div class="dropdown-menu">
                            <a class="dropdown-item" asp-area="@CommonConsts.AdminUIArea" asp-controller="Log" asp-action="AuditLog">Audit log</a>
                            @if (!AdminConfiguration.HideUIForMSSqlErrorLogging)
                            {
                                <a class="dropdown-item" asp-area="@CommonConsts.AdminUIArea" asp-controller="Log" asp-action="ErrorsLog">Error log</a>
                            }
                        </div>
                    </li>
                </ul>

                <a class="btn btn-primary cl-nav-cta ml-lg-auto" asp-area="@CommonConsts.AdminUIArea" asp-controller="Configuration" asp-action="ClientNew">
                    <span class="oi oi-plus" aria-hidden="true"></span> New client
                </a>
            </div>
        </div>
    </nav>

    <main class="cl-main">
        @RenderBody()
    </main>

    <footer class="cl-footer">
        &copy; @DateTime.Now.Year Clopay Corporation &middot; @AdminConfiguration.PageTitle &middot; @await Html.PartialAsync("Common/ApplicationVersion")
    </footer>

    <script src="~/dist/js/bundle.min.js" asp-append-version="true"></script>

    @await Html.PartialAsync("Common/Notification")

    @await RenderSectionAsync("scripts", required: false)
</body>
</html>
