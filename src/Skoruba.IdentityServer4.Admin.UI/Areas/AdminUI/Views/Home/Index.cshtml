@using Skoruba.IdentityServer4.Admin.UI.Configuration
@using Skoruba.IdentityServer4.Admin.UI.Configuration.Constants
@inject AdminConfiguration AdminConfiguration

@{
    ViewBag.Title = "Home";
    Layout = "_Layout";
}

<div class="cl-page">
    <h1 class="cl-title">Welcome</h1>
    <p class="cl-subtitle">Manage who can sign in to Clopay apps and APIs. Pick a task to get started.</p>

    <h2 class="cl-section">Common tasks</h2>
    <div class="cl-tiles">
        <a class="cl-tile cl-tile-accent" asp-area="@CommonConsts.AdminUIArea" asp-controller="Configuration" asp-action="ClientNew">
            <span class="cl-tile-icon oi oi-plus" aria-hidden="true"></span>
            <span class="cl-tile-label">Create a client</span>
            <span class="cl-tile-hint">Register a new app or service in a few clicks</span>
        </a>
        <a class="cl-tile" asp-area="@CommonConsts.AdminUIArea" asp-controller="Configuration" asp-action="Clients">
            <span class="cl-tile-icon oi oi-monitor" aria-hidden="true"></span>
            <span class="cl-tile-label">Clients &amp; secrets</span>
            <span class="cl-tile-hint">Find a client, rotate its secret, edit settings</span>
        </a>
        <a class="cl-tile" asp-area="@CommonConsts.AdminUIArea" asp-controller="Configuration" asp-action="ApiResources">
            <span class="cl-tile-icon oi oi-cloud" aria-hidden="true"></span>
            <span class="cl-tile-label">API resources</span>
            <span class="cl-tile-hint">APIs that clients can request access to</span>
        </a>
        <a class="cl-tile" asp-area="@CommonConsts.AdminUIArea" asp-controller="Configuration" asp-action="ApiScopes">
            <span class="cl-tile-icon oi oi-wrench" aria-hidden="true"></span>
            <span class="cl-tile-label">API scopes</span>
            <span class="cl-tile-hint">Permissions an API exposes</span>
        </a>
        <a class="cl-tile" asp-area="@CommonConsts.AdminUIArea" asp-controller="Configuration" asp-action="IdentityResources">
            <span class="cl-tile-icon oi oi-tags" aria-hidden="true"></span>
            <span class="cl-tile-label">Identity resources</span>
            <span class="cl-tile-hint">User information shared with apps</span>
        </a>
        <a class="cl-tile" asp-area="@CommonConsts.AdminUIArea" asp-controller="Grant" asp-action="PersistedGrants">
            <span class="cl-tile-icon oi oi-key" aria-hidden="true"></span>
            <span class="cl-tile-label">Active sessions</span>
            <span class="cl-tile-hint">Refresh tokens and consents; revoke a session</span>
        </a>
        <a class="cl-tile" asp-area="@CommonConsts.AdminUIArea" asp-controller="Log" asp-action="AuditLog">
            <span class="cl-tile-icon oi oi-eye" aria-hidden="true"></span>
            <span class="cl-tile-label">Audit log</span>
            <span class="cl-tile-hint">Who changed what, and when</span>
        </a>
        <a class="cl-tile" asp-area="@CommonConsts.AdminUIArea" asp-controller="Identity" asp-action="Users">
            <span class="cl-tile-icon oi oi-person" aria-hidden="true"></span>
            <span class="cl-tile-label">Admin users</span>
            <span class="cl-tile-hint">People who can sign in to this admin site</span>
        </a>
    </div>
</div>
