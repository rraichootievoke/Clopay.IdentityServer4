@using Skoruba.IdentityServer4.Admin.UI.Configuration.Constants
@model Skoruba.IdentityServer4.Admin.BusinessLogic.Dtos.Configuration.ClientSecretRotationResultDto

@{
    ViewBag.Title = "Secret rotated";
    Layout = "_Layout";
}

<div class="cl-page cl-narrow">
    <div class="cl-success-banner">
        <span class="oi oi-circle-check" aria-hidden="true"></span>
        <div>
            <h1 class="cl-title">New secret for @Model.ClientName</h1>
            <p class="cl-subtitle mb-0">Client ID: <strong>@Model.ClientIdentifier</strong></p>
        </div>
    </div>

    @await Html.PartialAsync("Client/SecretReveal", Model.NewSecret)

    <div class="cl-card cl-card-pad mt-4">
        <h2 class="cl-section mt-0">Next steps</h2>
        <ol class="cl-steps">
            <li>Put the new secret into the app's configuration (or Key Vault) and deploy.</li>
            <li>
                @if (Model.RetiredSecrets == 0)
                {
                    <text>There were no earlier secrets to retire.</text>
                }
                else if (Model.GracePeriodDays > 0)
                {
                    <text>The @Model.RetiredSecrets previous @(Model.RetiredSecrets == 1 ? "secret keeps" : "secrets keep") working until <strong>@(Model.GracePeriodEndsUtc?.ToString("yyyy-MM-dd HH:mm")) UTC</strong>, then expire automatically.</text>
                }
                else
                {
                    <text>The @Model.RetiredSecrets previous @(Model.RetiredSecrets == 1 ? "secret was" : "secrets were") <strong>revoked immediately</strong> - apps still using @(Model.RetiredSecrets == 1 ? "it" : "them") will fail to sign in until updated.</text>
                }
            </li>
            <li>Check that the app can get a token with the new secret.</li>
        </ol>
    </div>

    <div class="cl-form-actions">
        <a asp-area="@CommonConsts.AdminUIArea" asp-action="Clients" class="btn btn-primary">Back to clients</a>
        <a asp-area="@CommonConsts.AdminUIArea" asp-action="ClientSecrets" asp-route-id="@Model.ClientId" class="btn btn-secondary">View all secrets</a>
    </div>
</div>
