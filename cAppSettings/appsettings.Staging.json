    // CCAApp secret is deliberately its OWN hardened value, NOT the canonical 44ba09... value
    // Dev/Test use. Matches MyClopayCCAUI/src/app/shared/config/app.constant.ts `staging`.
    "client_secret": "c729724297b149138b6b2f94209a708e",
    "Environment": "staging-",
