{
    // ── Staging / pre-production environment ───────────────────────────────────
    // Loaded when ASPNETCORE_ENVIRONMENT=Staging
    // - Staging databases on MAS-SQL-01T (see MyClopayGWIAMAPI/_designs/Clopay_Database Names & Analysis.xlsx, sheet "DB")
    // - CORS restricted to *.clopay.com only — no localhost (closer to Prod posture than Test)
    // - Rate limiting: same moderate tier as Test, tightened client whitelist
    // - TODO: confirm whether Staging gets its own Key Vault (VaultUri below is blank,
    //   matching Test's "developer signing credential acceptable" posture — replace if
    //   your security policy requires signed tokens in Staging)
    "ConnectionStrings": {
        "IdentityServerDB": "Data Source=MAS-SQL-01T;Initial Catalog=IdentityServerDB_DBStaging_New;Persist Security Info=True;User ID=PortalAdmin;Password=PortalAdmin@123;Connect Timeout=200;pooling=true;TrustServerCertificate=True;Max Pool Size=100;",
        "CCADatabase": "Data Source=MAS-SQL-01T;Initial Catalog=DealerPortalDBStaging;Persist Security Info=True;User ID=PortalAdmin;Password=PortalAdmin@123;Connect Timeout=200;pooling=true;TrustServerCertificate=True;Max Pool Size=100;"
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft": "Warning",
            "Microsoft.Hosting.Lifetime": "Information",
            "IdentityServer4": "Information"
        }
    },
    // B2: CORS — staging/prod domains, plus http://localhost:4200 for local debugging
    // against Staging's IDP/data. The localhost entry isn't listed here directly -
    // this array only defines 2 entries, so it inherits the base appsettings.json
    // array's 3rd entry (config providers merge JSON arrays by index). Add it
    // explicitly here instead if Staging should stop depending on that inheritance.
    "AllowedOrigins": [
        "https://*.clopay.com",
        "http://*.clopay.com",
        "https://localhost:4200",
        "http://localhost:4200"
    ],
    // B1: TODO — confirm Staging Key Vault URI, or intentionally leave blank like Test
    "AzureKeyVault": {
        "VaultUri": "",
        "SigningCertificateName": "IdentityServerSigningCert"
    },
    // B3: Rate limiting — same shape as Test, IP/client whitelist scoped to Staging
    "IpRateLimiting": {
        "EnableEndpointRateLimiting": true,
        "StackBlockedRequests": false,
        "RealIpHeader": "X-Real-IP",
        "ClientIdHeader": "X-ClientId",
        "HttpStatusCode": 429,
        "IpWhitelist": [
            "127.0.0.1",
            "::1"
        ],
        "EndpointWhitelist": [
            "/health",
            "/health/ready",
            "/health/live"
        ],
        "ClientWhitelist": [
            "staging-automation",
            "swagger",
            "postman"
        ],
        "GeneralRules": [
            {
                "Endpoint": "POST:/connect/token",
                "Period": "1m",
                "Limit": 60
            },
            {
                "Endpoint": "POST:/connect/token",
                "Period": "1h",
                "Limit": 500
            },
            {
                "Endpoint": "POST:/connect/authorize",
                "Period": "1m",
                "Limit": 60
            }
        ]
    },
    "WebAPIBaseUrl": "https://staging-iam.clopay.com/api/",
    "tokenEndPoint": "https://staging-iam.clopay.com/connect/token",
    "ApplicationCategoryUrl": "https://staging-apigateway.clopay.com/api/cca/ApplicationCategory/GetApplicationsWithCategory?AuthToken=",
    "finalAccessUrl": "https://staging-apigateway.clopay.com/api/cca/Auth/PostFinalAccessKey",
    // Missing here until 2026-09-09: with no override, LoginController fell back to the base
    // appsettings.json values (https://ccaapi.clopay.com / https://securityapi.clopay.com -- the
    // real PRODUCTION hosts, no env prefix), so UpdateAgreedPolicyUser/LoginFailedCount and every
    // other LoginController call to these two APIs was silently calling Production from Staging.
    // Hosts confirmed against ocelot.Staging.json's staging-ccaapi.clopay.com / staging-securityapi.clopay.com routes.
    "CCADashboardApiUrl": "https://staging-ccaapi.clopay.com/api/",
    "CCASecurityApiUrl": "https://staging-securityapi.clopay.com/api/v1/",
