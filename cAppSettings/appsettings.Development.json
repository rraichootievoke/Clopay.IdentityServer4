{
  // ── Development environment ────────────────────────────────────────────────
  // Loaded when ASPNETCORE_ENVIRONMENT=Development - this is now the SHARED DEV
  // CLOUD TIER (dev-iam.clopay.com), not a local machine. Use "Local" instead for
  // on-machine debugging (see appsettings.Local.json).
  //
  // ⚠ AzureKeyVault.VaultUri is still blank below, meaning this environment falls
  // back to AddDeveloperSigningCredential - an EPHEMERAL key regenerated on every
  // app restart/recycle. That's fine for a machine nobody else depends on, but Dev
  // is a shared, longer-lived tier that other apps' RS256 validation depends on
  // (Gateway/CCA API/MyOrders all have a static copy of this IDP's RSA public key
  // in their own Jwt:RsaPublicKey config). Every restart here invalidates RS256
  // validation everywhere else until someone manually re-syncs the new public key.
  // Needs a real decision before relying on RS256 in Dev: either point VaultUri at
  // an actual Key Vault, or configure a persistent signing certificate.

  "ConnectionStrings": {
    "IdentityServerDB": "Data Source=10.103.3.4;Initial Catalog=IdentityServerDev;Persist Security Info=True;User ID=PortalAdmin;Password=_EDBDevServer050923;Connect Timeout=200;pooling=true;Max Pool Size=100",
    "CCADatabase": "Data Source=10.103.3.4;Initial Catalog=DealerPortalDBDev;User ID=PortalAdmin;Password=_EDBDevServer050923;Connect Timeout=30;"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "IdentityServer4": "Debug"
    }
  },

  // B2: CORS — Dev cloud origins (CCAUI + IAM Admin UI, once the latter exists)
  "AllowedOrigins": [
    "https://dev-cca.clopay.com",
    "https://dev-iamui.clopay.com",
    "https://*.clopay.com",
    "http://*.clopay.com",
    "https://www.google-analytics.com/analytics.js",
    "https://localhost:4200",
    "http://localhost:4200",
    "http://localhost:4201",
    "http://localhost:4202",
    "http://dev-cdn.clopay.com/clopay-header/",
    "https://dev-cdn.clopay.com/clopay-header/",
    "https://*.azurewebsites.net/"
  ],

  // B1: Leave blank → startup uses AddDeveloperSigningCredential (dev only)
  "AzureKeyVault": {
    "VaultUri": "",
    "SigningCertificateName": "IdentityServerSigningCert"
  },

  // B3: Rate limiting — very relaxed for local dev / Postman testing
  // Whitelisted clients & IPs are excluded from rate limits
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "IpWhitelist": [
      "127.0.0.1",
      "::1"
    ],
    "EndpointWhitelist": [
      "/health",
      "/health/ready",
      "/health/live"
    ],
    "ClientWhitelist": [
      "postman",
      "swagger",
      "test-client"
    ],
    "GeneralRules": [
      {
        "Endpoint": "POST:/connect/token",
        "Period": "1m",
        "Limit": 500
      },
      {
        "Endpoint": "POST:/connect/token",
        "Period": "1h",
        "Limit": 5000
      },
      {
        "Endpoint": "POST:/connect/authorize",
        "Period": "1m",
        "Limit": 500
      }
    ]
  },

  "AllowedHosts": "*",
  "WebAPIBaseUrl": "https://dev-iam.clopay.com/api/",
