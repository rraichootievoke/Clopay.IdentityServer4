{
  // ── IDP Admin UI - Local ── ASPNETCORE_ENVIRONMENT=Local ───────────────────────────────────────────────
  // For running on your own machine against the TEST IDP: set the connection string (and the client secret) with
  // `dotnet user-secrets` or environment variables - never commit them:
  //   dotnet user-secrets set "ConnectionStrings:ConfigurationDbConnection" "<read-only connection string>"
  //   dotnet user-secrets set "ConnectionStrings:PersistedGrantDbConnection" "<read-only connection string>"
    //   dotnet user-secrets set "AdminConfiguration:ClientSecret" "<client secret>"
  // The IDP client used must allow https://localhost:44303/signin-oidc as a redirect URI (use a "LocalDev" client).
  "AdminConfiguration": {
    "IdentityServerBaseUrl": "https://test-iam.clopay.com",
    "IdentityAdminRedirectUri": "https://localhost:44303/signin-oidc",
    "RequireHttpsMetadata": true,
    "ReadOnlyMode": true,
    "AllowedAdmins": []
  },
  "Logging": {
    "LogLevel": { "Default": "Debug", "Microsoft": "Information" }
  }
}
