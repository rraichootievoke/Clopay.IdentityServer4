@using Clopay.IDPAdminUI.Core.BusinessLogic.Shared.Dtos.Common
@using Clopay.IDPAdminUI.Configuration.Constants
@model Clopay.IDPAdminUI.Core.BusinessLogic.Dtos.Configuration.ClientsDto

@{
    ViewBag.Title = "Clients";
    Layout = "_Layout";
}

<div class="cl-page">
    <div class="cl-page-head">
        <div>
            <h1 class="cl-title">Clients</h1>
            <p class="cl-subtitle">Apps and services that are allowed to use this identity server. @Model.TotalCount in total.</p>
        </div>
    </div>

    <form asp-area="@CommonConsts.AdminUIArea" asp-controller="Configuration" asp-action="Clients" method="get" class="cl-search">
        <input name="search" value="@ViewBag.Search" type="search" placeholder="Search by client ID or name" class="form-control" autofocus />
        <button type="submit" class="btn btn-secondary">Search</button>
        @if (!string.IsNullOrEmpty(ViewBag.Search as string))
        {
            <a asp-area="@CommonConsts.AdminUIArea" asp-action="Clients" class="btn btn-link">Clear</a>
        }
    </form>

    <div class="cl-card">
        <div class="table-responsive">
            <table class="table cl-table">
                <thead>
                    <tr>
                        <th>Client ID</th>
                        <th>Name</th>
                        <th class="text-right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var client in Model.Clients)
                    {
                        <tr>
                            <td><a class="cl-link-strong" asp-area="@CommonConsts.AdminUIArea" asp-action="Client" asp-route-id="@client.Id">@client.ClientId</a></td>
                            <td>@client.ClientName</td>
                            <td class="text-right cl-actions">
                                <a asp-area="@CommonConsts.AdminUIArea" class="btn btn-sm btn-secondary" asp-action="Client" asp-route-id="@client.Id">Edit</a>
                                <a asp-area="@CommonConsts.AdminUIArea" class="btn btn-sm btn-secondary" asp-action="ClientSecretRotate" asp-route-id="@client.Id" title="Generate a new secret for this client"><span class="oi oi-reload" aria-hidden="true"></span> Rotate secret</a>
                                <a asp-area="@CommonConsts.AdminUIArea" class="btn btn-sm btn-outline-danger" asp-action="ClientDelete" asp-route-id="@client.Id" title="Delete client"><span class="oi oi-trash" aria-hidden="true"></span><span class="sr-only">Delete</span></a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Clients.Any())
                    {
                        <tr><td colspan="3" class="cl-empty">No clients found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @await Html.PartialAsync("Common/Pager", new Pager { Action = "Clients", PageSize = Model.PageSize, TotalCount = Model.TotalCount, Search = ViewBag.Search, EnableSearch = true })
</div>
