@using Clopay.IDPAdminUI.Configuration.Constants
@model Clopay.IDPAdminUI.Core.BusinessLogic.Dtos.Configuration.ClientSecretsDto

@{
    ViewBag.Title = "Rotate secret";
    Layout = "_Layout";
}

<div class="cl-page cl-narrow">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-area="@CommonConsts.AdminUIArea" asp-action="Clients">Clients</a></li>
            <li class="breadcrumb-item"><a asp-area="@CommonConsts.AdminUIArea" asp-action="Client" asp-route-id="@Model.ClientId">@Model.ClientName</a></li>
            <li class="breadcrumb-item active" aria-current="page">Rotate secret</li>
        </ol>
    </nav>

    <h1 class="cl-title">Rotate secret for @Model.ClientName</h1>
    <p class="cl-subtitle">A new random secret is generated and shown once. Choose what happens to the current @(Model.TotalCount == 1 ? "secret" : "secrets").</p>

    <form asp-area="@CommonConsts.AdminUIArea" asp-controller="Configuration" asp-action="ClientSecretRotate" asp-route-id="@Model.ClientId" method="post">
        <h2 class="cl-section">Current secrets (@Model.TotalCount)</h2>
        <div class="cl-card">
            <table class="table cl-table mb-0">
                <thead><tr><th>Type</th><th>Description</th><th>Created</th><th>Expires</th></tr></thead>
                <tbody>
                    @foreach (var secret in Model.ClientSecrets)
                    {
                        <tr>
                            <td>@secret.Type</td>
                            <td>@secret.Description</td>
                            <td>@secret.Created.ToString("yyyy-MM-dd")</td>
                            <td>@(secret.Expiration.HasValue ? secret.Expiration.Value.ToString("yyyy-MM-dd") : "Never")</td>
                        </tr>
                    }
                    @if (!Model.ClientSecrets.Any())
                    {
                        <tr><td colspan="4" class="cl-empty">This client has no secret yet - rotating will create the first one.</td></tr>
                    }
                </tbody>
            </table>
        </div>

        <h2 class="cl-section">What should happen to the old secrets?</h2>
        <div class="cl-choices cl-choices-stack">
            <label class="cl-choice selected">
                <input type="radio" name="gracePeriodDays" value="7" checked />
                <span class="cl-choice-body">
                    <strong>Keep them working for 7 days</strong>
                    <span>Recommended. Update the app with the new secret, then the old one expires on its own - no downtime.</span>
                </span>
            </label>
            <label class="cl-choice">
                <input type="radio" name="gracePeriodDays" value="1" />
                <span class="cl-choice-body">
                    <strong>Keep them working for 24 hours</strong>
                    <span>A short overlap for a quick same-day change.</span>
                </span>
            </label>
            <label class="cl-choice">
                <input type="radio" name="gracePeriodDays" value="30" />
                <span class="cl-choice-body">
                    <strong>Keep them working for 30 days</strong>
                    <span>For apps that take longer to roll out.</span>
                </span>
            </label>
            <label class="cl-choice">
                <input type="radio" name="gracePeriodDays" value="0" />
                <span class="cl-choice-body">
                    <strong>Revoke them immediately</strong>
                    <span>Use this if a secret may have leaked. Apps using the old secret stop working until updated.</span>
                </span>
            </label>
        </div>

        <div class="cl-form-actions">
            <button type="submit" class="btn btn-primary btn-lg"><span class="oi oi-reload" aria-hidden="true"></span> Generate new secret</button>
            <a asp-area="@CommonConsts.AdminUIArea" asp-action="Clients" class="btn btn-link">Cancel</a>
            <a class="cl-advanced" asp-area="@CommonConsts.AdminUIArea" asp-action="ClientSecrets" asp-route-id="@Model.ClientId">Add or remove secrets manually</a>
        </div>
    </form>
</div>

@section scripts {
    <script>
        $(function () {
            $('.cl-choices').on('change', 'input[type=radio]', function () {
                $('.cl-choice').removeClass('selected');
                $('.cl-choice input:checked').closest('.cl-choice').addClass('selected');
            });
        });
    </script>
}
