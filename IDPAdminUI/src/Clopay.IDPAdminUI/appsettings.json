{
  // Neutral defaults. Every environment file (Local / Development / Test / Staging / Production) overrides what differs.
  // Anything can also be set with environment variables, e.g.  AdminConfiguration__ReadOnlyMode=false
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "ConfigurationDbConnection": "",
    "PersistedGrantDbConnection": ""
  },

  "AdminConfiguration": {
    "PageTitle": "IAM Admin",
    "FaviconUri": "~/favicon.ico",

    // OpenID Connect sign-in through the Clopay IDP (filled in per environment)
    "IdentityServerBaseUrl": "",
    "IdentityAdminRedirectUri": "",
    "ClientId": "",
    "ClientSecret": "",
    "OidcResponseType": "code",
    "Scopes": [ "openid", "profile" ],
    "RequireHttpsMetadata": true,
    "IdentityAdminCookieName": "ClopayIdpAdminUi",
    "IdentityAdminCookieExpiresUtcHours": 12,
    "TokenValidationClaimName": "preferred_username",

    // Who may use the site: a user matches if ANY of preferred_username / name / email / sub equals one of these.
    // Empty = nobody. (Someone who signs in but is not listed sees the exact values to add.)
    "AllowedAdmins": [],

    // SAFETY SWITCH. true = view-only: every create/update/delete is refused. Set to false per environment to allow changes.
    "ReadOnlyMode": true
  },

  "Logging": {
    "FilePath": "Log",
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
