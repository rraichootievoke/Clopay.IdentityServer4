{
  // ── IDP Admin UI - Development ── loaded when ASPNETCORE_ENVIRONMENT=Development ───────────────────────────────────
  // The app has NO database of its own: it reads/updates the Clopay IDP database below and writes only log files.
  "ConnectionStrings": {
    // The Clopay IDP database (IdentityServer4 configuration + operational tables).
    "ConfigurationDbConnection": "Data Source=10.103.3.4;Initial Catalog=IdentityServerDev;Persist Security Info=True;User ID=PortalAdmin;Password=_EDBDevServer050923;Connect Timeout=200;pooling=true;Max Pool Size=100",
    "PersistedGrantDbConnection": "Data Source=10.103.3.4;Initial Catalog=IdentityServerDev;Persist Security Info=True;User ID=PortalAdmin;Password=_EDBDevServer050923;Connect Timeout=200;pooling=true;Max Pool Size=100"
  },

  "AdminConfiguration": {
    // Administrators sign in through the Clopay IDP with the client the old Identity Express UI used (ClientId "admin_ui", see appsettings.json).
    // The client SECRET is the old site's AdminUIClientSecret (web.config) - supply it as AdminConfiguration__ClientSecret, never commit it.
    "IdentityServerBaseUrl": "https://dev-iam.clopay.com",
    "IdentityAdminRedirectUri": "https://dev-iamui.clopay.com/signin-oidc",
    "ClientSecret": "<ADMIN_UI_CLIENT_SECRET>",
    "RequireHttpsMetadata": true,
    "ReadOnlyMode": true,
    "AllowedAdmins": []
  },

  "Logging": {
    "FilePath": "Log",
    "LogLevel": { "Default": "Debug", "Microsoft": "Information", "Microsoft.Hosting.Lifetime": "Information" }
  }
}
