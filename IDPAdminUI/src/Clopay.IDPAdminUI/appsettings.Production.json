{
  // ── PRODUCTION PLACEHOLDER ─ every <PLACEHOLDER> must be replaced (environment variables / Key Vault) before deploying;
  // the site refuses to start while any remain. For reference the APISecurity "DB-Name-Mapping" lists Prod as server 10.109.3.5,
  // database "identityserverdb" - confirm with the DBA before using them, and prefer a READ-ONLY SQL login to start with.
  // ── IDP Admin UI - Production ── loaded when ASPNETCORE_ENVIRONMENT=Production ───────────────────────────────────
  // The app has NO database of its own: it reads/updates the Clopay IDP database below and writes only log files.
  "ConnectionStrings": {
    // The Clopay IDP database (IdentityServer4 configuration + operational tables).
    "ConfigurationDbConnection": "Data Source=<PROD_SQL_SERVER>;Initial Catalog=<PROD_IDP_DATABASE>;Persist Security Info=True;User ID=<PROD_DB_USER>;Password=<DB_PASSWORD>;Connect Timeout=200;pooling=true;TrustServerCertificate=True;Max Pool Size=500",
    "PersistedGrantDbConnection": "Data Source=<PROD_SQL_SERVER>;Initial Catalog=<PROD_IDP_DATABASE>;Persist Security Info=True;User ID=<PROD_DB_USER>;Password=<DB_PASSWORD>;Connect Timeout=200;pooling=true;TrustServerCertificate=True;Max Pool Size=500"
  },

  "AdminConfiguration": {
    // Administrators sign in through the Clopay IDP with the client the old Identity Express UI used (ClientId "admin_ui", see appsettings.json).
    // The client SECRET is the old site's AdminUIClientSecret (web.config) - supply it as AdminConfiguration__ClientSecret, never commit it.
    "IdentityServerBaseUrl": "https://prod-iam.clopay.com",
    "IdentityAdminRedirectUri": "https://prod-iamui.clopay.com/signin-oidc",
    "ClientSecret": "<ADMIN_UI_CLIENT_SECRET>",
    "RequireHttpsMetadata": true,
    "ReadOnlyMode": true,
    "AllowedAdmins": []
  },

  "Logging": {
    "FilePath": "Log",
    "LogLevel": { "Default": "Information", "Microsoft": "Warning", "Microsoft.Hosting.Lifetime": "Information" }
  }
}
