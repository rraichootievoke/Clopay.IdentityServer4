{
  // ── IDP Admin UI - Staging ── loaded when ASPNETCORE_ENVIRONMENT=Staging ───────────────────────────────────
  // The app has NO database of its own: it reads/updates the Clopay IDP database below and writes only log files.
  "ConnectionStrings": {
    // The Clopay IDP database (IdentityServer4 configuration + operational tables).
    "ConfigurationDbConnection": "Data Source=MAS-SQL-01T;Initial Catalog=IdentityServerDB_DBStaging_New;Persist Security Info=True;User ID=PortalAdmin;Password=PortalAdmin@123;Connect Timeout=200;pooling=true;TrustServerCertificate=True;Max Pool Size=100",
    "PersistedGrantDbConnection": "Data Source=MAS-SQL-01T;Initial Catalog=IdentityServerDB_DBStaging_New;Persist Security Info=True;User ID=PortalAdmin;Password=PortalAdmin@123;Connect Timeout=200;pooling=true;TrustServerCertificate=True;Max Pool Size=100"
  },

  "AdminConfiguration": {
    // Administrators sign in through the Clopay IDP with the client the old Identity Express UI used (ClientId "admin_ui", see appsettings.json).
    // The client SECRET is the old site's AdminUIClientSecret (web.config) - supply it as AdminConfiguration__ClientSecret, never commit it.
    "IdentityServerBaseUrl": "https://staging-iam.clopay.com",
    "IdentityAdminRedirectUri": "https://staging-iamui.clopay.com/signin-oidc",
    "ClientSecret": "<ADMIN_UI_CLIENT_SECRET>",
    "RequireHttpsMetadata": true,
    "ReadOnlyMode": true,
    "AllowedAdmins": []
  },

  "Logging": {
    "FilePath": "Log",
    "LogLevel": { "Default": "Information", "Microsoft": "Warning", "Microsoft.Hosting.Lifetime": "Information" }
  }
}
